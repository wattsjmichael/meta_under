# UNDER - Unity .gitignore
# Keep Assets/, Packages/, and ProjectSettings/ in source control.

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store / package build artifacts
AssetStoreTools*

# IDE / editor generated
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated metadata/debug artifacts
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Builds / packages
*.apk
*.aab
*.unitypackage

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Gradle / Android generated
.gradle/
**/.gradle/
**/build/

# Local environment / secrets
.env
.env.*
!.env.example
*.keystore
*.jks

# Temporary backup files
*~
*.bak
*.orig
